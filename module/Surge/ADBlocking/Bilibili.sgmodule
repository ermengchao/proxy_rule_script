#!name = Bilibili
#!category = AD Blocking
#!desc = Blocks splash-screen and recommendation-feed ads in the Bilibili iOS app; removes Game Center, Create and Shop navigation entries and the frequently visited creators section in Dynamics. Uses app2smile scripts and enables HTTP/2 MITM; the MITM switch and a fully trusted CA certificate are required. Leaves video-detail and comment responses untouched to avoid the observed video-detail fallback delay; video-page ads may remain. Does not cover the Bilibili website.
#!requirement = SYSTEM == 'iOS'

# Upstream scripts: https://github.com/app2smile/rules
# Keep View/View excluded: rewritten responses were followed by an approximately 8-second fallback in local captures.

[MITM]
h2       = true
hostname = %APPEND% app.bilibili.com, grpc.biliapi.net

[Script]
bili-json  = type=http-response, pattern=^https:\/\/app\.bilibili\.com\/x\/(v2\/(splash\/(list|show)|feed\/index\?)|resource\/show\/tab\/v2), requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/bilibili-json.js, script-update-interval=0
bili-proto = type=http-response, pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.dynamic\.v2\.Dynamic\/DynAll$, requires-body=1, binary-body-mode=1, max-size=0, script-path=https://raw.githubusercontent.com/app2smile/rules/master/js/bilibili-proto.js, script-update-interval=0
