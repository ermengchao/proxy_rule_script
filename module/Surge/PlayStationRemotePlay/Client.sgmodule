#!name = Client
#!category = PlayStation Remote Play
#!desc = For a Remote Play Mac client
#!arguments = Host, Proxy:Tailnet, enableDiscovery:false

[Rule]
#!REQUIREMENT "'{{{enableDiscovery}}}'=='true'" AND,((PROCESS-NAME,RemotePlay),(PROTOCOL,UDP),(IP-CIDR,198.19.255.255/32),(DEST-PORT,9302)), PS5 Discovery
IP-CIDR, {{{Host}}}/32                                , {{{Proxy}}}, no-resolve
AND    , ((PROCESS-NAME, RemotePlay), (PROTOCOL, UDP)), Direct
AND    , ((DEST-PORT, 3478-3479)    , (PROTOCOL, UDP)), Direct
